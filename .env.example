# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EMPRESA_ID=00000000-0000-0000-0000-000000000001

# Token compartido para las rutas /api (chat, fotos, update-code).
# Sin este valor las rutas responden 401.
ADMIN_API_TOKEN=

# Claude (server-side)
ANTHROPIC_API_KEY=

# Push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Credenciales de acceso — SOLO hashes SHA-256 con salt.
# Generar con:
#   node -e "const c=require('crypto');console.log('s2:'+c.createHash('sha256').update('belfast-obras:v2:'+process.argv[1]).digest('hex'))" 'TU_PASSWORD'
NEXT_PUBLIC_ADMIN_PASS_HASH=
NEXT_PUBLIC_SUPERVISOR_PASS_HASH=
NEXT_PUBLIC_SUPERADMIN_USER=
NEXT_PUBLIC_SUPERADMIN_PASS_HASH=
NEXT_PUBLIC_SUPERADMIN_NOMBRE=

# Auto-actualización de código vía IA (deshabilitada por defecto)
ENABLE_CODE_UPDATES=false
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
PRODUCTION_URL=
PREVIEW_URL_TEMPLATE=
